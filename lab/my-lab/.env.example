# my-lab 실행 키 — 실제 값은 절대 커밋하지 말 것 (.gitignore 에 포함됨)
# 각 줄의 '=' 뒤에 키를 붙여넣고 저장 후 커널을 재시작하세요.

# 필수 3종 (노트 [REAL] 셀이 키 유무를 확인해 실행/스킵)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=

# 선택 — 아래는 my-lab 기본 노트에서 직접 쓰진 않지만 필요 시 추가
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# COHERE_API_KEY=
# GROQ_API_KEY=
